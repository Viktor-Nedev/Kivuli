node_modules/
dist/
.env
.env.local
*.log
.cache/
# Cache contents, not the directory itself: git cannot re-include a file
# inside an ignored directory, so the negation below only works if the rule
# matches files rather than the folder.
data/cache/*
# ...except one rainfall archive. The Season page needs eleven years of ERA5,
# and a hackathon venue network cannot be relied on, so committing a single
# snapshot lets the demo run offline exactly as the bundled station CSV does.
# Everything else in the cache stays ignored and is refetched on demand.
# The pattern covers every curated site (the key carries lat_lon), so the
# location switcher works with no network too, not just the station site.
!data/cache/daily_*_2015-01-01_*.json
# ...and one forecast snapshot. The next-three-days outlook is the headline
# feature of the forward view, and without a warm cache it is the single thing
# that dies on a bad venue network. Stale by demo day, but the stale-fallback
# path is exactly what it is there to exercise.
!data/cache/forecast_3d.json
.DS_Store
.scratch/
.claude/
