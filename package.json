{
  "name": "kivuli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Climate intelligence that turns JKUAT Conduit ground observations into timed field decisions.",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-reporter=spec \"server/**/*.test.ts\" \"web/src/map/**/*.test.ts\""
  },
  "dependencies": {
    "express": "^4.21.2",
    "gsap": "^3.15.0",
    "mapbox-gl": "^3.9.0",
    "react-router-dom": "^7.18.3",
    "suncalc": "^1.9.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/geojson": "^7946.0.14",
    "@types/mapbox-gl": "^3.4.1",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/suncalc": "^1.9.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
